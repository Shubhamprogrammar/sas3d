# Copy this file to .env.local and fill in your values.
# Never commit real keys to the repository.

# Email provider (used by src/app/api/contact/route.ts)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where team notifications are sent (defaults to SITE.email)
CONTACT_EMAIL=hello@SAS3D.studio
# Verified sender for Resend (defaults to onboarding@resend.dev)
# CONTACT_FROM=SAS3D Studio <hello@sas3d.studio>

# Calendly / booking
# BOOKING_URL=https://cal.com/your-handle
