# Copy this file to .env.local and fill in your values.
# Never commit real keys to the repository.

# Email via SMTP with Nodemailer (used by src/app/api/contact/route.ts)
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sas3dev@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# Sender shown on emails (defaults to "SAS3D <SMTP_USER>"). Gmail only allows
# SMTP_USER or one of its verified "Send mail as" aliases.
# MAIL_FROM=SAS3D <sas3dev@gmail.com>
# Where inquiry notifications are sent (defaults to SITE.email)
CONTACT_EMAIL=sas3dev@gmail.com

# MongoDB Atlas (stores contact form submissions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (defaults to sas3d)
# MONGODB_DB=sas3d

# Password for the inquiries dashboard at /admin-dashboard (admin is disabled when unset).
# Use a long random value, e.g. from: openssl rand -base64 24
ADMIN_PASSWORD=

# Calendly / booking
# BOOKING_URL=https://cal.com/your-handle

# Google Tag Manager container (public ID; loads only in production builds).
# Defaults to GTM-T44V5578. Google Analytics (G-KCLJR5CQ84) is configured
# inside GTM, not here — see docs/manual-setup-checklist.md.
# NEXT_PUBLIC_GTM_ID=GTM-T44V5578
